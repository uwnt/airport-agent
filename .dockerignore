# Keep the build context small and free of secrets: only pyproject.toml, uv.lock, README.md and
# src/ are needed.
.git
.github
.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.coverage
dist
*.egg-info

# Secrets: never in an image
.env
.env.*
*.pem
*.key

# Not needed at runtime
data/cache
docs
tests
scripts
Makefile
CLAUDE*.md
Dockerfile
.dockerignore
docker-compose.yml
