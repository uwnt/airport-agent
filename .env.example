# Names only: real values live in Doppler (project airport-agent, config dev).
# Run commands with: doppler run -- <cmd>
# Comments sit on their own lines because Docker's --env-file keeps inline comments as part of the value.

# Google Gemini API key (aistudio.google.com); use a dedicated key with a spending cap
GEMINI_API_KEY=
# Optional model settings (defaults in src/airport_agent/llm.py)
# Gemini model name, e.g. a Flash-tier or Pro-tier model from Google's model list
GEMINI_MODEL=
# Longest answer, in tokens
MAX_ANSWER_TOKENS=
# Most tool calls the agent may make for one question
MAX_TOOL_CALLS=
# Seconds to wait for one model call
REQUEST_TIMEOUT_SECONDS=
# How much the model thinks before answering: minimal, low, medium or high
GEMINI_THINKING_LEVEL=
# OpenSky Network API client (free account)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Data snapshots: where they live (only file://<folder> is built) and how often, in minutes, the
# server looks for a newer one. Both optional; these are the defaults.
DATA_STORE=file://data/snapshots
DATA_CHECK_MINUTES=5

# Optional (stretch step 6d)
# "Refresh on this machine"; keep false on any public deployment
ALLOW_LOCAL_REFRESH=false
# Slack/Discord webhook for refresh summaries
NOTIFY_WEBHOOK_URL=

# Maintainer only, not needed to run the app:
# GH_TOKEN             fine-grained GitHub token for this one repo, used for gh commands
# GITHUB_TOKEN_REFRESH fine-grained token with Actions: write; lets the Refresh button start the workflow
