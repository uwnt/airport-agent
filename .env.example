# Names only: real values live in Doppler (project airport-agent, config dev).
# Run commands with: doppler run -- <cmd>
GEMINI_API_KEY=        # Google Gemini API key (aistudio.google.com); use a dedicated key with a spending cap
OPENSKY_CLIENT_ID=     # OpenSky Network API client (free account)
OPENSKY_CLIENT_SECRET=
GH_TOKEN=              # fine-grained GitHub token for this one repo (contents, issues, pull requests)
# Optional (stretch step 6d):
ALLOW_LOCAL_REFRESH=true  # "Refresh on this machine"; set false on any public deployment
GITHUB_TOKEN_REFRESH=  # maintainer only: fine-grained token, Actions: write on this repo; lets the Refresh button start the workflow
NOTIFY_WEBHOOK_URL=    # Slack/Discord webhook for refresh summaries
